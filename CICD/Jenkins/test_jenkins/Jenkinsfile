pipeline {
    agent any
    
    tools {
        nodejs 'Node-26.4.0'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Backend: Build & Test') {
            steps {
                dir('CICD/Jenkins/test_jenkins/backend') {
                    sh './gradlew --no-daemon clean build'
                }
            }
            post {
                always {
                    junit testResults: 'CICD/Jenkins/test_jenkins/backend/build/test-results/test/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Frontend: Install, Test & Build') {
            steps {
                dir('CICD/Jenkins/test_jenkins/frontend') {
                    sh 'yarn install --immutable'
                    sh 'yarn test:ci'
                    sh 'yarn build'
                }
            }
            post {
                always {
                    junit testResults: 'CICD/Jenkins/test_jenkins/frontend/test-results/junit.xml',
                          allowEmptyResults: true
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'CICD/Jenkins/test_jenkins/backend/build/libs/*.jar, CICD/Jenkins/test_jenkins/frontend/dist/**',
                             fingerprint: true
        }
    }
}
